{
  "data": {"data_folder": "./data", "crop_size": 128, "scaling_factor": 4},
  "model": {"n_blocks_g": 32, "n_channels_g": 128, "res_scale": 0.1},
  "train": {
    "batch_size": 8,
    "start_epoch": 1,
    "epochs": 60,
    "workers": 0,
    "lr": 0.00008,
    "pin_memory": true,
    "print_every": 20,
    "save_every": 20,
    "keep_last": 8,
    "resume_checkpoint": "",
    "init_checkpoint": "./checkpoints/srresnet_x4/edsr_x4_best.pth"
  },
  "loss": {"l1_weight": 0.2, "mse_weight": 0.8},
  "scheduler": {"type": "multistep", "warmup_epochs": 5, "milestones": [80, 160, 240, 280], "gamma": 0.5, "min_lr_factor": 0.01},
  "save_dir": "./checkpoints/x4",
  "backup_dir": "./checkpoints_backup/x4",
  "log_dir": "./runs/x4",
  "csv_log": "./runs/x4/train_metrics.csv",
  "monitor": {
    "enabled": true,
    "every": 1,
    "target_psnr": 28.0,
    "patience": 90,
    "min_delta": 0.0002,
    "eval_config": "./configs/eval_x4_set14_edsr.json",
    "csv_log": "./runs/x4/val_metrics.csv"
  }
}
